{
  "name": "lifehack2026",
  "version": "0.1.0",
  "private": true,
  "description": "A recycling competition web application.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "format": "prettier \"src/**/*.js\" \"tests/**/*.js\" vite.config.js eslint.config.js --write",
    "format:check": "prettier \"src/**/*.js\" \"tests/**/*.js\" vite.config.js eslint.config.js --check",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test:unit": "vitest run",
    "test": "npm run format:check && npm run lint:js && npm run lint:styles && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@supabase/supabase-js": "^2.97.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}

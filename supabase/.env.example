# Copy to supabase/.env.local for local Edge Function development.
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_VLM=true
ALLOW_VLM_FALLBACK=true
ALLOWED_ORIGIN=http://localhost:3000
CRON_SECRET=
CONTACT_GOOGLE_CLIENT_ID=
CONTACT_GOOGLE_CLIENT_SECRET=
CONTACT_GOOGLE_REDIRECT_URI=http://localhost:54321/functions/v1/manage-contacts
CONTACT_FACEBOOK_CLIENT_ID=
CONTACT_FACEBOOK_CLIENT_SECRET=
CONTACT_FACEBOOK_REDIRECT_URI=http://localhost:54321/functions/v1/manage-contacts
CONTACTS_REDIRECT_URL=http://localhost:3000/
